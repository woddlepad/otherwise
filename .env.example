# --- Core ---
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_agent
# LLMs via Neon AI Gateway (injected automatically inside Neon Functions; `neon env pull -s ai-gateway` for local)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Any Mastra model-router id; neon/claude-* goes through the gateway's Anthropic endpoint (src/lib/model.ts)
MODEL=neon/claude-opus-5-5

# --- WhatsApp via Twilio sandbox ---
# console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public base URL that Twilio calls (the cloudflared URL). Used for signature checks.
PUBLIC_URL=
# Set to 1 to skip Twilio signature checks while debugging
TWILIO_SKIP_SIGNATURE=0

# --- Later milestones ---
EXA_API_KEY=
KERNEL_API_KEY=
AGENTMAIL_API_KEY=
