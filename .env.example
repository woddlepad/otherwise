# --- Core ---
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_agent
# LLMs via Neon AI Gateway (Mastra's built-in neon/ provider reads these two)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Any Mastra model-router id
MODEL=neon/claude-opus-5-5
# Fallback: Mastra Gateway (msk_...) with MODEL=mastra/anthropic/claude-sonnet-5-5
# MASTRA_GATEWAY_API_KEY=

# --- WhatsApp via Twilio sandbox ---
# console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Stable public base URL (ngrok static domain or the deployed app). Used by Twilio signature
# checks, the onboarding link, and the OAuth redirect URIs, which must be registered with Google/Microsoft.
PUBLIC_URL=
# Optional: `npm run tunnel` uses ngrok with this static domain instead of a throwaway cloudflared URL
NGROK_DOMAIN=
# Set to 1 to skip Twilio signature checks while debugging
TWILIO_SKIP_SIGNATURE=0

# --- Onboarding: mail + calendar via Composio (managed OAuth, no Google/Microsoft app needed) ---
# platform.composio.dev → Settings → API key. Toolkits used: gmail, googlecalendar, outlook.
COMPOSIO_API_KEY=

# --- Demo payment (shown on the setup page; never sent to the LLM) ---
DEMO_CARD_LAST4=4242

# --- Booking flow (src/mastra/workflows/book.ts, docs/booking/PLAN.md) ---
# The card the booking workflow pays ticket shops with. Code types it into the payment page with Playwright;
# it never reaches the LLM, tool results or logs. Expiry as MM/YY.
BOOKING_CARD_NUMBER=
BOOKING_CARD_EXP=
BOOKING_CARD_CVC=
BOOKING_CARD_NAME=
# Optional: email for ticket shops when the user has none on file; model for the checkout sub-agent
# BOOKING_CONTACT_EMAIL=
# BOOKING_MODEL=neon/claude-sonnet-5
# 1 = serve the mock ticket shop "Ticketeria" at /mock/shop and include its events in find-events (Berlin users).
# Off in production. It accepts only BOOKING_CARD_NUMBER (or MOCK_SHOP_CARD).
MOCK_SHOP=

# --- Stripe (test mode): prepaid credit top-ups (src/lib/credits.ts) ---
# dashboard.stripe.com → Developers → API keys. The webhook secret belongs to an endpoint pointing at
# <PUBLIC_URL>/webhooks/stripe (events: checkout.session.completed, checkout.session.async_payment_succeeded).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Search, browser, agent inbox ---
EXA_API_KEY=
KERNEL_API_KEY=
AGENTMAIL_API_KEY=

# Required as X-Dev-Token header on POST /dev/chat (the app is publicly reachable)
DEV_CHAT_TOKEN=

# --- Dev worktrees (plugins/worktrees) ---
# Shared secret for webhooks production forwards to dev worktrees; same value in prod and every worktree
DEV_FORWARD_SECRET=
# Production only: forward phones listed in dev_routes to their worktree
# WHATSAPP_ROUTER=1
# Worktrees only: outbound WhatsApp is limited to these numbers (comma-separated E.164)
# WHATSAPP_ALLOWLIST=
