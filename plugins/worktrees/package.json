{
  "name": "@atmos-plugin/worktrees",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "esbuild server/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.mjs --external:pg-native --banner:js=\"import{createRequire as ___cr}from'module';const require=___cr(import.meta.url);\" && vite build --config ui/vite.config.ts",
    "pretest": "npm run build",
    "test": "node --test server/server.test.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p ui"
  },
  "dependencies": {
    "@atmos.build/extension": "^0.1.2",
    "@atmos.build/ui": "^0.1.13",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
